# Copy this file to .env and fill in your values.
# .env is gitignored -- never commit it.
#
# CI all the way, no local deploy -- so the only thing this file is for is
# setting the PULUMI_ACCESS_TOKEN GitHub secret once, from your own machine.
# No AWS keys here at all: infra provisioning and every deploy happen inside
# GitHub Actions via OIDC role assumption (the ingress stack already trusts
# any repo under this GitHub account), never with static AWS credentials.

# ── Pulumi Cloud ──────────────────────────────────────────────────────────────
# Same token as your other sites -- one Pulumi Cloud account, many stacks.
# Get this from: https://app.pulumi.com -> Avatar -> Access Tokens
PULUMI_ACCESS_TOKEN=
